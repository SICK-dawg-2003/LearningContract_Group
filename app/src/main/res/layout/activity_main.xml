<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. TITLE SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvContractTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Learning Contract"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B18" />

                <TextView
                    android:id="@+id/tvStudentInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groupwork # 1"
                    android:textSize="25sp"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvCourseInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course: Mobile App Development | Date: Feb 2026"
                    android:textSize="14sp"
                    android:textColor="#555555" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. EXPECTATIONS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expectations"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B18"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Gain a strong understanding of Kotlin and Android UI principles.\n• Successfully build and publish a fully functional mobile application prototype.\n• Learn to Sync Gradle Projects between multiple version."
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. CONTRIBUTIONS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contributions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B18"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Create UI implementation from learning Kotlin/Java/XML.\n• Actively participate in CC17 team activities and coding session.\n• Assist teammates with debugging and documentation tasks."
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. MOTIVATIONS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motivations"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B18"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Passionate about creating intuitive software that solves real-world problems.\n• Aspiring to build a career in Android software engineering.\n• Eager to add a polished project to my portfolio."
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. HINDRANCE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hindrance &amp; Mitigations"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B18"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Challenge: Managing time alongside other major course subjects.\n  └ Mitigation: Maintain a strict schedule and set weekly personal deadlines.\n• Challenge: Unfamiliarity with some code and syntax functions.\n  └ Mitigation: Dedicate 1-2 hours weekly to extra reading and practice."
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. SIGNED BY -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signed By"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B18"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Group: UniSync: Aquino, Ian Charles | Bacani, Angela Mae | Balidoy, Mark | Belnas, Maria Francine Scerah | Romeo, Cristel Shaine"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instructor Signature & Name: Sir Venn Edward Nicolas"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="#333333"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date Signed: October 1, 2026"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>